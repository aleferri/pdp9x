01.010 COMMENT DO DI RIGA, DI GRUPPO, ANNIDATO, E RETURN DAL MEZZO
01.020 SET T=0
01.030 DO 02.010
01.040 TYPE "RIGA ", T, !
01.050 SET T=0
01.060 DO 2
01.070 TYPE "GRUPPO ", T, !
01.080 SET T=0
01.090 DO 03.010
01.100 TYPE "ANNIDATO ", T, !
01.110 SET T=0
01.120 DO 4
01.130 TYPE "ORDINE ", T, !
01.140 SET T=0
01.150 DO 6
01.160 TYPE "RETURN ", T, !
01.170 SET T=0; DO 02.010; TYPE "SEMI ", T, !
01.180 QUIT
02.010 SET T=T+1
02.020 SET T=T+100
03.010 DO 02.010
04.010 SET T=T+1
04.020 SET T=T*10
04.030 SET T=T+3
05.010 SET T=999
06.010 SET T=T+7
06.020 IF (T-7) 06.030; RETURN
06.030 SET T=T+100
07.010 SET T=888
