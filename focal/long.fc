01.010 SET A AS LONG = 12345
01.020 TYPE "A ", A, " ATTESO 12345", !
01.030 SET B AS LONG = -131072
01.040 TYPE "B ", B, " ATTESO -131072", !
01.050 SET C AS LONG = 0
01.060 TYPE "C ", C, " ATTESO 0", !
01.070 SET P AS LONG = 100000*20
01.080 TYPE "P ", P, " ATTESO 2000000", !
01.090 SET Q AS LONG = 131071*131071
01.100 TYPE "Q ", Q, " ATTESO 17179607041", !
01.110 SET R AS LONG = 0-100000*30
01.120 TYPE "R ", R, " ATTESO -3000000", !
01.130 SET S AS LONG = 100000*20/7
01.140 TYPE "S ", S, " ATTESO 285714", !
01.150 SET T AS LONG = 3000000000
01.160 TYPE "T ", T, " ATTESO 3000000000", !
