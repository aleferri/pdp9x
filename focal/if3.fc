01.010 SET D=1800; SET S=2800
01.020 IF (D-S) 01.030, 01.040, 01.050
01.030 TYPE "A NEG", !; GOTO 01.060
01.040 TYPE "B ZERO", !; GOTO 01.060
01.050 TYPE "C POS", !
01.060 TYPE "VAL ", D-S, !
01.070 IF (0-5) 01.080, 01.090, 01.090
01.080 TYPE "D NEG", !; GOTO 01.100
01.090 TYPE "E NON NEG", !
01.100 QUIT
