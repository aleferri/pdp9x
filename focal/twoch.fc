10 SET A=1; SET A1=2; SET A2=3; SET AB=4; SET B=5
20 TYPE "A ", A, " A1 ", A1, " A2 ", A2, " AB ", AB, " B ", B, !
30 SET N9=A1+A2+AB
40 TYPE "N9 ", N9, " ATTESO 9", !
50 SET S1 AS STRING
60 SET S1="DUE CARATTERI"
70 TYPE "S1 ", S1, " LEN ", FLEN(S1), !
80 FOR I1=1,4; SET N9=N9+I1
90 TYPE "DOPO IL FOR ", N9, " ATTESO 19", !
100 SET Q7(2)=42
110 TYPE "Q7(2) ", Q7(2), !
120 QUIT
