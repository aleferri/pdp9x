01.010 SET A=1; SET A1=2; SET A2=3; SET AB=4; SET B=5
01.020 TYPE "A ", A, " A1 ", A1, " A2 ", A2, " AB ", AB, " B ", B, !
01.030 SET N9=A1+A2+AB
01.040 TYPE "N9 ", N9, " ATTESO 9", !
01.050 SET S1 AS STRING
01.060 SET S1="DUE CARATTERI"
01.070 TYPE "S1 ", S1, " LEN ", FLEN(S1), !
01.080 FOR I1=1,4; SET N9=N9+I1
01.090 TYPE "DOPO IL FOR ", N9, " ATTESO 19", !
01.100 SET Q7(2)=42
01.110 TYPE "Q7(2) ", Q7(2), !
01.120 QUIT
