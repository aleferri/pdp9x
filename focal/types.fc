01.010 SET A AS STRING
01.020 SET B AS STRING
01.030 SET N AS INT
01.040 SET A="HELLO"
01.050 SET B=A
01.060 SET N=1234
01.070 TYPE A, " ", B, " ", N, " LEN ", FLEN(A), !
01.080 SET C AS STRING = N
01.090 TYPE "C IS ", C, !
01.100 SET D AS STRING
01.110 SET D="-56XYZ"
01.120 TYPE "SUM ", D+N, !
01.130 QUIT
