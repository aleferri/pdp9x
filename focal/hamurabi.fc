10 COMMENT HAMURABI, DA THE SUMER GAME, FOCAL SU PDP-8, 1968
20 SET K=0; SET W=0; SET Z=0
30 SET P=95; SET S=2800; SET H=3000; SET E=200; SET Y=3; SET A=1000; SET I=5
50 TYPE "GOVERNA SUMERIA PER DIECI ANNI", !
60 SET Z=Z+1
70 TYPE !, "ANNO ", Z, " POP ", P, " ACRI ", A, !
80 TYPE "RACCOLTO ", Y, " PER ACRO, TOTALE ", H, !
90 TYPE "I RATTI NE HANNO PRESI ", E, " IN CASSA ", S, !
100 SET V=17+FRAN(10)
110 TYPE "UN ACRO COSTA ", V, !
120 TYPE "ACRI DA COMPRARE"; ASK B
130 IF (B) 901, 160, 140
140 IF (V*B-S) 160, 160, 891
160 SET A=A+B; SET S=S-V*B
170 TYPE "BUSHEL DA MANGIARE"; ASK G
180 IF (G) 903, 200, 190
190 IF (G-S) 200, 200, 893
200 SET S=S-G
210 TYPE "ACRI DA SEMINARE"; ASK L
220 IF (L) 905, 250, 230
230 IF (L-A) 240, 240, 895
240 IF (L/2-S) 250, 250, 895
250 SET S=S-L/2
260 SET Y=1+FRAN(5); SET H=L*Y
270 SET E=0; SET C=FRAN(5)
280 IF (C-2) 300, 290, 290
290 SET E=S/2
300 SET S=S-E+H
310 SET I=FRAN(5)*(20*A+S)/P/100+1
320 SET C=G/20
330 IF (C-P) 350, 340, 340
340 SET D=0; GOTO 370
350 SET D=P-C; SET K=K+D
360 IF (D*100-P*45) 370, 370, 800
370 SET W=W+D*100/P
380 SET P=C+I
390 IF (Z-10) 60, 500, 500
500 TYPE !, "DIECI ANNI PASSATI", !
510 TYPE "MORTI DI FAME ", K, " ACRI PER TESTA ", A/P, !
520 IF (W/10-33) 530, 530, 540
530 TYPE "HAI GOVERNATO BENE", !
535 QUIT
540 TYPE "IL POPOLO TI RICORDA MALE", !
545 QUIT
800 TYPE !, "TROPPI MORTI DI FAME, SEI DEPOSTO", !
810 QUIT
891 TYPE "HAMURABI, NON ABBIAMO TANTI BUSHEL", !
892 GOTO 120
893 TYPE "HAMURABI, NON ABBIAMO TANTO", !
894 GOTO 170
895 TYPE "HAMURABI, NON ABBIAMO TANTI ACRI", !
896 GOTO 210
901 TYPE "HAMURABI, RIPENSACI", !
902 GOTO 120
903 TYPE "HAMURABI, RIPENSACI", !
904 GOTO 170
905 TYPE "HAMURABI, RIPENSACI", !
906 GOTO 210
