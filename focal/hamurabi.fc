01.010 COMMENT HAMURABI, DA THE SUMER GAME, FOCAL SU PDP-8 1968
01.020 COMMENT VENDITA, PESTE, LIMITE DI SEMINA E GIUDIZIO A QUATTRO LIVELLI
01.030 SET K=0; SET W=0; SET Z=0; SET Q=0; SET D=0; SET I=5
01.040 SET P=100; SET A=1000; SET S=2800; SET H=3000; SET Y=3; SET E=200
01.050 TYPE "GOVERNA SUMERIA PER DIECI ANNI", !
01.060 SET Z=Z+1
01.070 TYPE !, "ANNO ", Z, !
01.080 TYPE "MORTI DI FAME ", D, " ARRIVATI ", I, !
01.090 IF (Q) 01.110, 01.110, 01.100
01.100 TYPE "LA PESTE NE HA UCCISI ", Q, !
01.110 TYPE "POPOLAZIONE ", P, " ACRI ", A, !
01.120 TYPE "RACCOLTO ", Y, " PER ACRO, RATTI ", E, " IN CASSA ", S, !
01.130 SET V=17+FRAN(10)
01.140 TYPE "UN ACRO COSTA ", V, !
01.150 TYPE "ACRI DA COMPRARE, NEGATIVO PER VENDERE"; ASK B
01.160 IF (B) 01.170, 01.200, 01.180
01.170 SET N=-B; IF (N-A) 01.190, 01.190, 01.891
01.180 IF (V*B-S) 01.200, 01.200, 01.893
01.190 GOTO 01.200
01.200 SET A=A+B; SET S=S-V*B
01.210 TYPE "BUSHEL DA MANGIARE"; ASK G
01.220 IF (G) 01.895, 01.240, 01.230
01.230 IF (G-S) 01.240, 01.240, 01.897
01.240 SET S=S-G
01.250 TYPE "ACRI DA SEMINARE"; ASK L
01.260 IF (L) 01.899, 01.300, 01.270
01.270 IF (L-A) 01.280, 01.280, 01.901
01.280 IF (L/2-S) 01.290, 01.290, 01.903
01.290 IF (L-10*P) 01.300, 01.300, 01.905
01.300 SET S=S-L/2
01.310 SET Y=1+FRAN(5); SET H=L*Y
01.320 SET E=0; SET C=1+FRAN(5)
01.330 SET N=C/2; IF (C-N*2) 01.350, 01.340, 01.350
01.340 SET E=S/C
01.350 SET S=S-E+H
01.360 SET N=A/5+S/100; SET I=(1+FRAN(5))*N/P+1
01.370 SET Q=0; IF (FRAN(100)-15) 01.380, 01.390, 01.390
01.380 SET Q=P/2; SET P=P-Q
01.390 SET C=G/20
01.400 IF (C-P) 01.420, 01.410, 01.410
01.410 SET D=0; GOTO 01.440
01.420 SET D=P-C; SET K=K+D
01.430 IF (D*100-P*45) 01.440, 01.440, 01.800
01.440 SET W=W+D*100/P
01.450 SET P=C+I
01.460 IF (Z-10) 01.060, 01.500, 01.500
01.500 TYPE !, "DIECI ANNI DI GOVERNO", !
01.510 SET W=W/10; SET L=A/P
01.520 TYPE "IN MEDIA ", W, " PER CENTO MORTI DI FAME OGNI ANNO", !
01.530 TYPE "IN TOTALE ", K, " MORTI. HAI CHIUSO CON ", L, " ACRI A TESTA", !
01.540 IF (W-33) 01.550, 01.560, 01.560
01.550 IF (L-7) 01.560, 01.570, 01.570
01.560 TYPE "SEI STATO DICHIARATO FINK NAZIONALE", !
01.565 QUIT
01.570 IF (W-10) 01.580, 01.590, 01.590
01.580 IF (L-9) 01.590, 01.600, 01.600
01.590 TYPE "LA TUA MANO PESANTE SA DI NERONE E IVAN IV", !
01.595 QUIT
01.600 IF (W-3) 01.610, 01.620, 01.620
01.610 IF (L-10) 01.620, 01.630, 01.630
01.620 TYPE "POTEVI FARE MEGLIO, MA NON E ANDATA MALE", !
01.625 QUIT
01.630 TYPE "UNA PRESTAZIONE FANTASTICA", !
01.635 QUIT
01.800 TYPE !, "TROPPI MORTI DI FAME IN UN ANNO. SEI DEPOSTO", !
01.810 QUIT
01.891 TYPE "HAMURABI, POSSEDIAMO SOLO ", A, " ACRI", !
01.892 GOTO 01.150
01.893 TYPE "HAMURABI, ABBIAMO SOLO ", S, " BUSHEL", !
01.894 GOTO 01.150
01.895 TYPE "HAMURABI, RIPENSACI", !
01.896 GOTO 01.210
01.897 TYPE "HAMURABI, ABBIAMO SOLO ", S, " BUSHEL", !
01.898 GOTO 01.210
01.899 TYPE "HAMURABI, RIPENSACI", !
01.900 GOTO 01.250
01.901 TYPE "HAMURABI, POSSEDIAMO SOLO ", A, " ACRI", !
01.902 GOTO 01.250
01.903 TYPE "HAMURABI, ABBIAMO SOLO ", S, " BUSHEL DA SEMENTE", !
01.904 GOTO 01.250
01.905 TYPE "HAMURABI, ABBIAMO SOLO ", P, " PERSONE PER COLTIVARE", !
01.906 GOTO 01.250
