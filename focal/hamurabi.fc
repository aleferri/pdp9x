10 COMMENT HAMURABI, DA THE SUMER GAME, FOCAL SU PDP-8 1968
20 COMMENT VENDITA, PESTE, LIMITE DI SEMINA E GIUDIZIO A QUATTRO LIVELLI
30 SET K=0; SET W=0; SET Z=0; SET Q=0; SET D=0; SET I=5
40 SET P=100; SET A=1000; SET S=2800; SET H=3000; SET Y=3; SET E=200
50 TYPE "GOVERNA SUMERIA PER DIECI ANNI", !
60 SET Z=Z+1
70 TYPE !, "ANNO ", Z, !
80 TYPE "MORTI DI FAME ", D, " ARRIVATI ", I, !
90 IF (Q) 110, 110, 100
100 TYPE "LA PESTE NE HA UCCISI ", Q, !
110 TYPE "POPOLAZIONE ", P, " ACRI ", A, !
120 TYPE "RACCOLTO ", Y, " PER ACRO, RATTI ", E, " IN CASSA ", S, !
130 SET V=17+FRAN(10)
140 TYPE "UN ACRO COSTA ", V, !
150 TYPE "ACRI DA COMPRARE, NEGATIVO PER VENDERE"; ASK B
160 IF (B) 170, 200, 180
170 SET N=-B; IF (N-A) 190, 190, 891
180 IF (V*B-S) 200, 200, 893
190 GOTO 200
200 SET A=A+B; SET S=S-V*B
210 TYPE "BUSHEL DA MANGIARE"; ASK G
220 IF (G) 895, 240, 230
230 IF (G-S) 240, 240, 897
240 SET S=S-G
250 TYPE "ACRI DA SEMINARE"; ASK L
260 IF (L) 899, 300, 270
270 IF (L-A) 280, 280, 901
280 IF (L/2-S) 290, 290, 903
290 IF (L-10*P) 300, 300, 905
300 SET S=S-L/2
310 SET Y=1+FRAN(5); SET H=L*Y
320 SET E=0; SET C=1+FRAN(5)
330 SET N=C/2; IF (C-N*2) 350, 340, 350
340 SET E=S/C
350 SET S=S-E+H
360 SET N=A/5+S/100; SET I=(1+FRAN(5))*N/P+1
370 SET Q=0; IF (FRAN(100)-15) 380, 390, 390
380 SET Q=P/2; SET P=P-Q
390 SET C=G/20
400 IF (C-P) 420, 410, 410
410 SET D=0; GOTO 440
420 SET D=P-C; SET K=K+D
430 IF (D*100-P*45) 440, 440, 800
440 SET W=W+D*100/P
450 SET P=C+I
460 IF (Z-10) 60, 500, 500
500 TYPE !, "DIECI ANNI DI GOVERNO", !
510 SET W=W/10; SET L=A/P
520 TYPE "IN MEDIA ", W, " PER CENTO MORTI DI FAME OGNI ANNO", !
530 TYPE "IN TOTALE ", K, " MORTI. HAI CHIUSO CON ", L, " ACRI A TESTA", !
540 IF (W-33) 550, 560, 560
550 IF (L-7) 560, 570, 570
560 TYPE "SEI STATO DICHIARATO FINK NAZIONALE", !
565 QUIT
570 IF (W-10) 580, 590, 590
580 IF (L-9) 590, 600, 600
590 TYPE "LA TUA MANO PESANTE SA DI NERONE E IVAN IV", !
595 QUIT
600 IF (W-3) 610, 620, 620
610 IF (L-10) 620, 630, 630
620 TYPE "POTEVI FARE MEGLIO, MA NON E ANDATA MALE", !
625 QUIT
630 TYPE "UNA PRESTAZIONE FANTASTICA", !
635 QUIT
800 TYPE !, "TROPPI MORTI DI FAME IN UN ANNO. SEI DEPOSTO", !
810 QUIT
891 TYPE "HAMURABI, POSSEDIAMO SOLO ", A, " ACRI", !
892 GOTO 150
893 TYPE "HAMURABI, ABBIAMO SOLO ", S, " BUSHEL", !
894 GOTO 150
895 TYPE "HAMURABI, RIPENSACI", !
896 GOTO 210
897 TYPE "HAMURABI, ABBIAMO SOLO ", S, " BUSHEL", !
898 GOTO 210
899 TYPE "HAMURABI, RIPENSACI", !
900 GOTO 250
901 TYPE "HAMURABI, POSSEDIAMO SOLO ", A, " ACRI", !
902 GOTO 250
903 TYPE "HAMURABI, ABBIAMO SOLO ", S, " BUSHEL DA SEMENTE", !
904 GOTO 250
905 TYPE "HAMURABI, ABBIAMO SOLO ", P, " PERSONE PER COLTIVARE", !
906 GOTO 250
