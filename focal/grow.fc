01.010 SET A AS STRING
01.020 SET A="0123456"
01.030 TYPE "PICCOLA ", A, " LEN ", FLEN(A), !
01.040 SET B AS STRING
01.050 SET B="QUESTA STRINGA SUPERA LA CLASSE PICCOLA DI PARECCHIO"
01.060 TYPE "GRANDE LEN ", FLEN(B), " ATTESO 52", !
01.070 SET C AS STRING
01.080 SET C=B
01.090 TYPE "COPIATA LEN ", FLEN(C), " ATTESO 52", !
01.100 SET D AS STRING
01.110 FOR I=1,20; SET D="RIASSEGNATA PIU LUNGA DELLA CLASSE PICCOLA"
01.120 TYPE "IN CICLO LEN ", FLEN(D), " ATTESO 42", !
01.130 QUIT
