10 SET A AS STRING
20 SET A="0123456"
30 TYPE "PICCOLA ", A, " LEN ", FLEN(A), !
40 SET B AS STRING
50 SET B="QUESTA STRINGA SUPERA LA CLASSE PICCOLA DI PARECCHIO"
60 TYPE "GRANDE LEN ", FLEN(B), " ATTESO 52", !
70 SET C AS STRING
80 SET C=B
90 TYPE "COPIATA LEN ", FLEN(C), " ATTESO 52", !
100 SET D AS STRING
110 FOR I=1,20; SET D="RIASSEGNATA PIU LUNGA DELLA CLASSE PICCOLA"
120 TYPE "IN CICLO LEN ", FLEN(D), " ATTESO 42", !
130 QUIT
