01.010 SET S=0; FOR I=1,5; SET S=S+I
01.020 TYPE "a ", S, " ATTESO 15", !
01.030 SET S=0; FOR I=10,-3,1; SET S=S+I
01.040 TYPE "b ", S, " ATTESO 22", !
01.050 SET S=0; FOR I=5,5; SET S=S+I
01.060 TYPE "c ", S, " ATTESO 5", !
01.070 SET S=0; FOR I=5,-1,5; SET S=S+I
01.080 TYPE "d ", S, " ATTESO 5", !
01.090 SET S=0; FOR I=6,2; SET S=S+I
01.100 TYPE "e ", S, " ATTESO 0", !
01.110 SET S=0; FOR I=2,-1,6; SET S=S+I
01.120 TYPE "f ", S, " ATTESO 0", !
01.130 SET N=0; FOR I=-3,2,3; SET N=N+1
01.140 TYPE "g ", N, " ATTESO 4", !
01.145 SET N=0; FOR I=3,-2,-3; SET N=N+1
01.147 TYPE "h ", N, " ATTESO 4", !
01.150 QUIT
