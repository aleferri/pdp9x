10 COMMENT TRIANGULAR NUMBERS AND A THREE WAY TEST
20 SET A=7
30 SET B=A*(A+1)/2
40 TYPE "SUM TO ", A, " IS ", B, !
50 IF (B-28) 80, 60, 80
60 TYPE "TWENTY EIGHT, AS EXPECTED", !
70 GOTO 90
80 TYPE "UNEXPECTED VALUE", !
90 SET C=(B-3)*2-A/2
100 TYPE "C = ", C, !
110 TYPE "NEG ", -C+1000, !
120 QUIT
