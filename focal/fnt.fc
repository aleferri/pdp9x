01.010 SET B AS LONG = 100000*20
01.020 TYPE "B ", B, " ATTESO 2000000", !
01.030 SET C AS LONG = FSQT(144)
01.040 TYPE "C ", C, " ATTESO 12", !
01.050 SET D AS LONG = FABS(0-7)
01.060 TYPE "D ", D, " ATTESO 7", !
01.070 SET E AS LONG = FSGN(0-9)
01.080 TYPE "E ", E, " ATTESO -1", !
01.090 SET G AS LONG = FITR(25)
01.100 TYPE "G ", G, " ATTESO 25", !
01.110 SET S1 AS STRING = "CIAO"
01.120 SET H AS LONG = FLEN(S1)
01.130 TYPE "H ", H, " ATTESO 4", !
01.140 SET J AS LONG = FABS(0-7)*100000
01.150 TYPE "J ", J, " ATTESO 700000", !
01.160 SET N=5; SET P AS LONG = FSQT(N*N)*40000
01.170 TYPE "P ", P, " ATTESO 200000", !
01.180 QUIT
