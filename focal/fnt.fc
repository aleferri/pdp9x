10 SET B AS LONG = 100000*20
20 TYPE "B ", B, " ATTESO 2000000", !
30 SET C AS LONG = FSQT(144)
40 TYPE "C ", C, " ATTESO 12", !
50 SET D AS LONG = FABS(0-7)
60 TYPE "D ", D, " ATTESO 7", !
70 SET E AS LONG = FSGN(0-9)
80 TYPE "E ", E, " ATTESO -1", !
90 SET G AS LONG = FITR(25)
100 TYPE "G ", G, " ATTESO 25", !
110 SET S1 AS STRING = "CIAO"
120 SET H AS LONG = FLEN(S1)
130 TYPE "H ", H, " ATTESO 4", !
140 SET J AS LONG = FABS(0-7)*100000
150 TYPE "J ", J, " ATTESO 700000", !
160 SET N=5; SET P AS LONG = FSQT(N*N)*40000
170 TYPE "P ", P, " ATTESO 200000", !
180 QUIT
