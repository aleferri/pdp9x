10 COMMENT LUNAR LANDING GAME, JIM STORER 1969, EQUAZIONE DEL RAZZO
20 COMMENT LA MASSA CALA MENTRE BRUCIA, QUINDI LA SPINTA CRESCE
30 COMMENT SERIE DI -LN(1-Q) TRONCATA A DUE TERMINI: IL TERZO STA
40 COMMENT SOTTO LA RISOLUZIONE DELLA VIRGOLA FISSA A 4096
50 SET A AS LONG = 633600
60 SET V AS LONG = 52800
70 SET M AS LONG = 32500
80 SET T=0
90 TYPE "ATTERRA SULLA LUNA", !
100 TYPE !, "T ", T, " ALT ", A, " FT", !
110 TYPE "VEL ", V, " DECIMI DI FT/S  CARB ", M, !
120 TYPE "BRUCIA LB/S PER 10 S, 0 OPPURE 8 A 200"; ASK K
130 IF (K) 900, 210, 140
140 IF (K-8) 890, 150, 150
150 IF (K-200) 160, 160, 890
160 SET C AS LONG = M-16500
170 IF (10*K-C) 210, 210, 895
210 SET Q AS LONG = 4096*10*K/M
220 SET W AS LONG = Q*Q/4096
225 SET E AS LONG = Q+W/2
230 COMMENT 9504*10*E, NON 9504*E*10: IL PRIMO PRODOTTO DEVE STARE
235 COMMENT IN UNA PAROLA, PERCHE UN FATTORE PIU LARGO VIENE TRONCATO
240 SET D AS LONG = 528-9504*10*E/4096
250 SET B AS LONG = V+264-9504*10*(Q/2+W/6)/4096
260 SET A = A-B; SET V = V+D; SET M = M-10*K; SET T = T+10
270 IF (A) 300, 300, 280
280 IF (T-600) 100, 400, 400
300 TYPE !, "CONTATTO AL TEMPO ", T, " S", !
310 TYPE "IMPATTO A ", V, " DECIMI DI FT/S", !
320 IF (V-100) 330, 330, 340
330 TYPE "ATTERRAGGIO PERFETTO", !
335 QUIT
340 IF (V-1000) 350, 350, 360
350 TYPE "ATTERRAGGIO DURO, MA SEI VIVO", !
355 QUIT
360 IF (V-5000) 370, 370, 380
370 TYPE "SCAFO AMMACCATO, EQUIPAGGIO SCOSSO", !
375 QUIT
380 TYPE "UN CRATERE NUOVO SULLA LUNA", !
385 QUIT
400 TYPE "TEMPO SCADUTO", !
405 QUIT
890 TYPE "LA PORTATA VA DA 8 A 200, O ZERO", !
892 GOTO 120
895 TYPE "NON ABBIAMO TANTO CARBURANTE", !
897 GOTO 120
900 TYPE "RIPENSACI", !
905 GOTO 120
