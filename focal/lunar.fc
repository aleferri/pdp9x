10 COMMENT LUNAR LANDING GAME, JIM STORER 1969
20 COMMENT A IN METRI, V IN CM/S, C IN CM/S2. IN MM/S LA VELOCITA SFORAVA
30 COMMENT I 131071 DI UNA PAROLA A 18 BIT DOPO 81 SECONDI DI CADUTA
40 SET A=1500; SET V=100; SET M=500; SET T=0
50 TYPE "ATTERRA SULLA LUNA. GRAVITA 162 CM/S2", !
60 TYPE !, "T ", T, " ALT ", A, " M VEL ", V, " CM/S CARB ", M, !
70 TYPE "BRUCIA PER 10 S"; ASK K
80 IF (K) 900, 120, 90
90 IF (K-M) 120, 120, 890
120 SET T=T+10; SET M=M-K
130 SET C=162-K*18
140 SET D=V/10+C/2
150 SET A=A-D; SET V=V+C*10
160 IF (A) 300, 300, 200
200 IF (M) 210, 220, 220
210 TYPE "CARBURANTE ESAURITO", !
220 IF (T-600) 60, 400, 400
300 TYPE !, "CONTATTO AL TEMPO ", T, " S", !
310 TYPE "IMPATTO A ", V, " CM/S", !
320 IF (V-100) 330, 330, 340
330 TYPE "ATTERRAGGIO PERFETTO", !
335 QUIT
340 IF (V-500) 350, 350, 360
350 TYPE "ATTERRAGGIO DURO, MA SEI VIVO", !
355 QUIT
360 TYPE "UN CRATERE NUOVO SULLA LUNA", !
365 QUIT
400 TYPE "TEMPO SCADUTO", !
405 QUIT
890 TYPE "NON NE ABBIAMO TANTO", !
895 GOTO 70
900 TYPE "RIPENSACI", !
905 GOTO 70
