01.010 COMMENT LUNAR LANDING GAME, JIM STORER 1969, EQUAZIONE DEL RAZZO
01.020 COMMENT LA MASSA CALA MENTRE BRUCIA, QUINDI LA SPINTA CRESCE
01.030 COMMENT SERIE DI -LN(1-Q) TRONCATA A DUE TERMINI: IL TERZO STA
01.040 COMMENT SOTTO LA RISOLUZIONE DELLA VIRGOLA FISSA A 4096
01.050 SET A AS LONG = 633600
01.060 SET V AS LONG = 52800
01.070 SET M AS LONG = 32500
01.080 SET T=0
01.090 TYPE "ATTERRA SULLA LUNA", !
01.100 TYPE !, "T ", T, " ALT ", A, " FT", !
01.110 TYPE "VEL ", V, " DECIMI DI FT/S  CARB ", M, !
01.120 TYPE "BRUCIA LB/S PER 10 S, 0 OPPURE 8 A 200"; ASK K
01.130 IF (K) 01.900, 01.210, 01.140
01.140 IF (K-8) 01.890, 01.150, 01.150
01.150 IF (K-200) 01.160, 01.160, 01.890
01.160 SET C AS LONG = M-16500
01.170 IF (10*K-C) 01.210, 01.210, 01.895
01.210 SET Q AS LONG = 4096*10*K/M
01.220 SET W AS LONG = Q*Q/4096
01.225 SET E AS LONG = Q+W/2
01.230 COMMENT 9504*10*E, NON 9504*E*10: IL PRIMO PRODOTTO DEVE STARE
01.235 COMMENT IN UNA PAROLA, PERCHE UN FATTORE PIU LARGO VIENE TRONCATO
01.240 SET D AS LONG = 528-9504*10*E/4096
01.250 SET B AS LONG = V+264-9504*10*(Q/2+W/6)/4096
01.260 SET A = A-B; SET V = V+D; SET M = M-10*K; SET T = T+10
01.270 IF (A) 01.300, 01.300, 01.280
01.280 IF (T-600) 01.100, 01.400, 01.400
01.300 TYPE !, "CONTATTO AL TEMPO ", T, " S", !
01.310 TYPE "IMPATTO A ", V, " DECIMI DI FT/S", !
01.320 IF (V-100) 01.330, 01.330, 01.340
01.330 TYPE "ATTERRAGGIO PERFETTO", !
01.335 QUIT
01.340 IF (V-1000) 01.350, 01.350, 01.360
01.350 TYPE "ATTERRAGGIO DURO, MA SEI VIVO", !
01.355 QUIT
01.360 IF (V-5000) 01.370, 01.370, 01.380
01.370 TYPE "SCAFO AMMACCATO, EQUIPAGGIO SCOSSO", !
01.375 QUIT
01.380 TYPE "UN CRATERE NUOVO SULLA LUNA", !
01.385 QUIT
01.400 TYPE "TEMPO SCADUTO", !
01.405 QUIT
01.890 TYPE "LA PORTATA VA DA 8 A 200, O ZERO", !
01.892 GOTO 01.120
01.895 TYPE "NON ABBIAMO TANTO CARBURANTE", !
01.897 GOTO 01.120
01.900 TYPE "RIPENSACI", !
01.905 GOTO 01.120
