# iverilog model of the 18-bit machine.
#
# The control store, the map ROMs and the field definitions are generated by
# ucode.py, so the RTL cannot drift away from the microassembler.
#
#   make          build and run the sieve
#   make trace    dump the first cycles for comparison with the Python engine

IVFLAGS = -g2005

all: run

hex:
	cd .. && python3 ucode.py hex

sim.vvp: pdp9x.v tb.v ufields.vh
	iverilog $(IVFLAGS) -o $@ pdp9x.v tb.v

run: sim.vvp
	vvp sim.vvp +prog=sieve4.hex

trace: sim.vvp
	vvp sim.vvp +prog=sieve4.hex +trace

clean:
	rm -f sim.vvp
