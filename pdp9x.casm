// ---- OPR group 3: stack.  bit11 = pop, bits 10:9 = I field ----
.inline G3
.with ( d : Ints, ifield : Ints, mask : Ints ) -> {
    .return 0x3E000 + ( d << 11 ) + ( ifield << 9 ) + mask;
}

.opcode PSH {{ r0 }}
.with ( r0 : SReg ) -> {
    .out [ .expr G3(0, 0, ( 1 << r0 )) ];
}

.opcode PSH {{ r0 , r1 }}
.with ( r0 : SReg, r1 : SReg ) -> {
    .out [ .expr G3(0, 0, ( 1 << r0 ) + ( 1 << r1 )) ];
}

.opcode PSH {{ r0 , r1 , r2 }}
.with ( r0 : SReg, r1 : SReg, r2 : SReg ) -> {
    .out [ .expr G3(0, 0, ( 1 << r0 ) + ( 1 << r1 ) + ( 1 << r2 )) ];
}

.opcode PSH {{ r0 , r1 , r2 , r3 }}
.with ( r0 : SReg, r1 : SReg, r2 : SReg, r3 : SReg ) -> {
    .out [ .expr G3(0, 0, ( 1 << r0 ) + ( 1 << r1 ) + ( 1 << r2 ) + ( 1 << r3 )) ];
}

.opcode POP {{ r0 }}
.with ( r0 : SReg ) -> {
    .out [ .expr G3(1, 0, ( 1 << r0 )) ];
}

.opcode POP {{ r0 , r1 }}
.with ( r0 : SReg, r1 : SReg ) -> {
    .out [ .expr G3(1, 0, ( 1 << r0 ) + ( 1 << r1 )) ];
}

.opcode POP {{ r0 , r1 , r2 }}
.with ( r0 : SReg, r1 : SReg, r2 : SReg ) -> {
    .out [ .expr G3(1, 0, ( 1 << r0 ) + ( 1 << r1 ) + ( 1 << r2 )) ];
}

.opcode POP {{ r0 , r1 , r2 , r3 }}
.with ( r0 : SReg, r1 : SReg, r2 : SReg, r3 : SReg ) -> {
    .out [ .expr G3(1, 0, ( 1 << r0 ) + ( 1 << r1 ) + ( 1 << r2 ) + ( 1 << r3 )) ];
}

