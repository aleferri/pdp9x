// ---- IOT ----
//  17..14  13..11  10..8   7..4   3    2     1     0
//   1110   dev(3)  sub(3)  ----  CLA  IOP4  IOP2  IOP1
.opcode IO {{ a }}
.with ( a : Ints ) -> {
    .out [ 0x38000 + a ];
}

.opcode SCROLL {{ }}
.with ( ) -> {
    .out [ 0x38804 ];
}

.opcode SKBSY {{ }}
