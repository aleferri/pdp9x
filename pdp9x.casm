// 18-bit accumulator machine, PDP-9 derived.
// Assemble with: casmeleon -lang=pdp9x.casm -byteSize=32 -endian=big -export=bin f.s

.num 16 "0x" ""
.num 2 "0b" ""
.num 8 "0o" ""

.set XReg {
    X;
}

// bit position of each register inside the G3 stack mask
.set SReg {
    SP;
    LPC;
    IX;
    AC;
}

.inline MR
.with ( op : Ints, ind : Ints, idx : Ints, r : Ints, a : Ints ) -> {
    .if a < 0 || a > 2047 {
        .error a, "memory reference address outside the 11 bit zero page";
    }
    .return ( op << 14 ) + ( ind << 13 ) + ( idx << 12 ) + ( r << 11 ) + a;
}

.inline JPC
.with ( op : Ints, a : Ints, here : Ints ) -> {
    // a == 0 means the label is still unresolved on the first pass;
    // casmeleon re-evaluates it later, so an .error here would be fatal.
    .if a != 0 && ( a >> 12 ) != ( here >> 12 ) {
        .error a, "CAL/JMP direct is PC-page relative: target is in another 4K page";
    }
    .return ( op << 14 ) + ( a & 4095 );
}

.inline JC
.with ( op : Ints, ind : Ints, idx : Ints, a : Ints ) -> {
    .if a < 0 || a > 4095 {
        .error a, "jump class address outside the 12 bit zero page";
    }
    .return ( op << 14 ) + ( ind << 13 ) + ( idx << 12 ) + a;
}

.opcode TAD {{ a }}
.with ( a : Ints ) -> {
    .out [ .expr MR(0, 0, 0, 0, a) ];
}

.opcode TAD {{ a , x }}
.with ( a : Ints, x : XReg ) -> {
    .out [ .expr MR(0, 0, 1, 0, a) ];
}

.opcode TAD {{ ( a ) }}
.with ( a : Ints ) -> {
    .out [ .expr MR(0, 1, 0, 0, a) ];
}

.opcode TAD {{ ( a ) , x }}
.with ( a : Ints, x : XReg ) -> {
    .out [ .expr MR(0, 1, 1, 0, a) ];
}

